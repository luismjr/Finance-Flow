# Finance Flow — Environment Variables
# Copy to .env and fill in real values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgresql://finance:finance@localhost:5432/financeflow

# Alpha Vantage — free tier: 25 req/day, 5 req/min
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo

# FRED (Federal Reserve Economic Data) — free, no limit
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# GCS (Google Cloud Storage) — for cloud deployment
# GCS_BUCKET_NAME=financeflow-raw-data
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# BigQuery — for cloud deployment
# BIGQUERY_PROJECT_ID=your-project-id
# BIGQUERY_DATASET_ID=financeflow

# dbt
DBT_TARGET=dev
