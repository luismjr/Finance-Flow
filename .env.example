# Finance Flow — Environment Variables
# Copy to .env and fill in real values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgresql://finance:finance@localhost:5432/financeflow

# Alpha Vantage — free tier: 25 req/day, 5 req/min
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo

# FRED (Federal Reserve Economic Data) — free, no limit
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# GCS + BigQuery — optional, for real cloud loads instead of local-only mode.
# Leave unset to run entirely locally (Airflow tasks will log what they would
# have uploaded/loaded instead of calling GCP). To go live:
#   1. Create a GCP project and enable the Cloud Storage + BigQuery APIs
#   2. Create a service account with Storage Object Admin + BigQuery Data Editor
#      + BigQuery Job User roles, download its JSON key
#   3. Save the key as airflow/secrets/gcp-credentials.json (gitignored, and
#      already mounted into the Airflow containers by docker-compose.yml)
#   4. Create a GCS bucket and set GCS_BUCKET_NAME to its name
#   5. Uncomment and fill in the values below
# GCS_BUCKET_NAME=financeflow-raw-data
# BIGQUERY_PROJECT_ID=your-project-id
# BIGQUERY_DATASET_ID=financeflow
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/secrets/gcp-credentials.json

# dbt — "dev" runs against local Postgres; set to "bigquery" once the GCS/BigQuery
# vars above are filled in, so `make dbt-run`/`make dbt-test` transform the real
# BigQuery tables instead of Postgres.
DBT_TARGET=dev
